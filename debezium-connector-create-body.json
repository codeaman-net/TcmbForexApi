{
  "name": "rates-activity",
  "config": {
    "plugin.name": "pgoutput",
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "database.hostname": "postgres.tcmbforexapi.orb.local",
    "database.port": "5432",
    "database.user": "admin",
    "database.password": "vZhDmz2B9rsUtuPkDBmLkb7sXsb3DF4",
    "database.dbname": "DapperDB",
    "table.include.list": "public.forex_rates",
    "topic.prefix": "tcmb",
    "decimal.handling.mode": "double",
